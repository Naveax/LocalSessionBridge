{
  "manifest_version": 3,
  "name": "Universal Local Session Bridge",
  "version": "1.0.0",
  "description": "Kullanıcının izin verdiği sitelerin cookie snapshotlarını yalnız yerel broker'a aktarır.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:17871/*",
    "http://localhost:17871/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.basecamp.com/*"
      ],
      "js": [
        "probe-wake.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background-wrapper.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Session Bridge"
  }
}
