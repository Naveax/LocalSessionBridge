{
  "manifest_version": 3,
  "name": "Universal Local Session Bridge",
  "version": "1.0.0",
  "description": "Kullan\u0131c\u0131n\u0131n izin verdi\u011fi sitelerin cookie snapshotlar\u0131n\u0131 yaln\u0131z yerel broker'a aktar\u0131r.",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:17871/*",
    "http://localhost:17871/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Session Bridge"
  }
}